# Regenerable/environment-specific only, plus the Google service-account
# key below -- a real credential, never meant to leave this PC.
venv/
.venv/
backend/.venv/
__pycache__/
*.pyc
frontend-react/node_modules/
frontend-react/dist/
backend/phone_images/*
!backend/phone_images/.gitkeep
backend/test_receipts/*
!backend/test_receipts/.gitkeep
backend/.setup_complete
backend/tray_server.log
# Auto-generated safety copy from Tools > Backup & Restore > Restore
# from .db -- only ever exists on an install where a restore was
# actually run, so a fresh clone is never affected by this exclusion.
backend/*.before-restore-*.db

# Live shop data, not source code -- was tracked (since before this
# repo's own history began), meaning every past push already baked a
# permanent snapshot of the shop's real details into a public repo.
# init_db() (backend/core/database.py) already creates and seeds a
# fresh, working database from nothing on every startup if this file
# doesn't exist, so a new clone starts empty and fully functional --
# this exclusion only stops future real data from joining it.
backend/dropfix.db
backend/dropfix_test.db
# Same reasoning, for any manual on-disk safety copy of the live db
# taken before a risky operation (e.g. before a full functional audit).
backend/dropfix.pre-audit-safety-*.db
.DS_Store
Thumbs.db
*.pdf
*.xlsx

# Google Cloud service-account key (Tools > Google Connection) -- grants
# write access to the shop's real Sheets/Drive, must never be public.
backend/dropfix_google_key.json
key/

# Google Drive backup's OAuth client + the token from the one-time
# sign-in (Tools > Google Connection) -- same sensitivity as the
# service-account key above, must never be public.
backend/dropfix_drive_oauth_client.json
backend/dropfix_drive_oauth_token.json

# Local day-to-day working notes -- never shared, never pushed.
CLAUDE.md
